<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        An action an administrator runs by hand, deliberately not a
        `post_init_hook`. `homemenu_config` holds a per-user preference, set by
        dragging an icon on the Enterprise app grid; wiping everybody's as a
        silent side effect of installing a module would be indefensible in
        something we publish. Users who have never dragged an app need nothing
        from this action, since `reorderApps` is only called when the stored
        config is non-null; they see this module's order already.

        The logic lives in `res.users.settings.reset_app_grid_order()` so that it
        is ordinary Python, covered by the tests, rather than a string in a data
        file that nothing can lint.

        `model_id` is `ir.actions.server` rather than the model the code touches.
        That field decides where an action can be triggered from, not what it
        operates on, and the Run button on the form carries
        `invisible="model_name != 'ir.actions.server' or state != 'code'"`, so
        binding it to a real model hides the only way to run it by hand.
    -->
    <record id="action_reset_app_grid_order" model="ir.actions.server">
        <field name="name">Reset per-user app grid order</field>
        <field name="model_id" ref="base.model_ir_actions_server" />
        <field name="state">code</field>
        <field name="code">action = env["res.users.settings"].reset_app_grid_order()</field>
    </record>
</odoo>
