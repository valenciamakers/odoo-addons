<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_event_slot_form_multiday" model="ir.ui.view">
        <field name="name">event.slot.form.multiday</field>
        <field name="model">event.slot</field>
        <field name="inherit_id" ref="event.view_event_slot_form"/>
        <field name="arch" type="xml">
            <!-- One range of start and end, as the event form has, in place
                 of core's "Hour range". Core's slot form has no date at all:
                 a slot is created by clicking a day in the slot calendar, and
                 a slot that may end on another day needs both days shown.
                 Shown in the event's timezone, as core shows a slot
                 everywhere else; the help is core's own, from the hours.
                 Core computes both datetimes; the widget saves the slot's
                 date, hours and day count instead, so they stay read-only
                 on the model and are editable only here. -->
            <label for="start_hour" position="before">
                <field name="start_datetime" string="Date" widget="vmk_event_slot_daterange"
                       options="{'end_date_field': 'end_datetime', 'tz_field': 'date_tz'}"
                       readonly="0" help="Expressed in the event timezone."/>
            </label>
            <!-- Hidden, not removed: other modules anchor on these. -->
            <label for="start_hour" position="attributes">
                <attribute name="invisible">1</attribute>
            </label>
            <xpath expr="//field[@name='start_hour']/.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_event_slot_tree_multiday" model="ir.ui.view">
        <field name="name">event.slot.list.multiday</field>
        <field name="model">event.slot</field>
        <field name="inherit_id" ref="event.view_event_slot_tree"/>
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="vmk_end_date" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
