#. module: base
#: model:ir.module.module,shortdesc:base.module_vmk_event_slot_multiday
msgid "Multi-Day Event Slots"
msgstr "多天活动时段"

#. module: base
#: model:ir.module.module,summary:base.module_vmk_event_slot_multiday
msgid "Allow event slots to span multiple days"
msgstr "允许活动时段跨越多天"

#. module: vmk_event_slot_multiday
#. odoo-python
#: code:addons/vmk_event_slot_multiday/models/event_slot.py:0
msgid "A slot cannot end before it starts: %(slot)s ends on %(end)s."
msgstr "时段的结束时间不能早于开始时间：%(slot)s 结束于 %(end)s。"

#. module: vmk_event_slot_multiday
#. odoo-python
#: code:addons/vmk_event_slot_multiday/models/event_slot.py:0
msgid "A slot hour must be between 0:00 and 23:59."
msgstr "时段小时必须在 0:00 至 23:59 之间。"

#. module: vmk_event_slot_multiday
#. odoo-python
#: code:addons/vmk_event_slot_multiday/models/event_slot.py:0
msgid ""
"A slot's end date and its number of days disagree: it ends on %(end)s, which"
" is %(offset)s days after its date, not %(given)s."
msgstr "时段的结束日期与其天数不一致：它结束于 %(end)s，即其日期之后 %(offset)s 天，而不是 %(given)s 天。"

