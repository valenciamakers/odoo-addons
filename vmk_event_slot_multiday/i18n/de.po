#. module: vmk_event_slot_multiday
#. odoo-python
#: code:addons/vmk_event_slot_multiday/models/event_slot.py:0
msgid "A slot cannot end before it starts: %(slot)s ends on %(end)s."
msgstr ""
"Ein Zeitfenster kann nicht vor seinem Beginn enden: %(slot)s endet am "
"%(end)s."

#. module: vmk_event_slot_multiday
#. odoo-python
#: code:addons/vmk_event_slot_multiday/models/event_slot.py:0
msgid "A slot hour must be between 0:00 and 23:59."
msgstr "Das Zeitfenster muss zwischen 0:00 und 23:59 liegen."

#. module: vmk_event_slot_multiday
#. odoo-python
#: code:addons/vmk_event_slot_multiday/models/event_slot.py:0
msgid ""
"A slot's end date and its number of days disagree: it ends on %(end)s, which"
" is %(offset)s days after its date, not %(given)s."
msgstr ""
"Das Enddatum eines Zeitfensters und seine Anzahl an Tagen stimmen nicht "
"überein: Es endet am %(end)s, also %(offset)s Tage nach seinem Datum, nicht "
"%(given)s."

