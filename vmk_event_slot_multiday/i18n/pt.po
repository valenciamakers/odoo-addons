#. module: vmk_event_slot_multiday
#. odoo-python
#: code:addons/vmk_event_slot_multiday/models/event_slot.py:0
msgid "A slot cannot end before it starts: %(slot)s ends on %(end)s."
msgstr ""
"Uma faixa de horário não pode terminar antes de começar: %(slot)s termina em"
" %(end)s."

#. module: vmk_event_slot_multiday
#. odoo-python
#: code:addons/vmk_event_slot_multiday/models/event_slot.py:0
msgid "A slot hour must be between 0:00 and 23:59."
msgstr "A hora da faixa de horário deve estar entre 0:00 e 23:59."

#. module: vmk_event_slot_multiday
#. odoo-python
#: code:addons/vmk_event_slot_multiday/models/event_slot.py:0
msgid ""
"A slot's end date and its number of days disagree: it ends on %(end)s, which"
" is %(offset)s days after its date, not %(given)s."
msgstr ""
"A data final de uma faixa de horário e o seu número de dias não coincidem: "
"termina em %(end)s, ou seja, %(offset)s dias depois da sua data, e não "
"%(given)s."

