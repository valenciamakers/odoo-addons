msgstr "Einddatum"

#. module: vmk_event_slot_multiday
#: model:ir.model,name:vmk_event_slot_multiday.model_event_slot
msgid "Event Slot"
msgstr "Evenementtijdslot"

#. module: vmk_event_slot_multiday
#: model_terms:ir.ui.view,arch_db:vmk_event_slot_multiday.view_event_slot_form_multiday
msgid "Expressed in the event timezone."
msgstr "Uitgedrukt in de tijdzone van het evenement."

#. module: vmk_event_slot_multiday
#: model:ir.model.fields,help:vmk_event_slot_multiday.field_event_slot__vmk_end_day_offset
msgid ""
"How many days after its date the slot ends. 0 for a slot within one day."
msgstr ""
"Hoeveel dagen na de datum het tijdslot eindigt. 0 voor een tijdslot binnen "
"één dag."

#. module: vmk_event_slot_multiday
#: model:ir.model.fields,field_description:vmk_event_slot_multiday.field_event_slot__id
msgid "ID"
msgstr "ID"

