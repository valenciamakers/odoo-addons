#. module: vmk_event_slot_multiday
#. odoo-python
#: code:addons/vmk_event_slot_multiday/models/event_slot.py:0
msgid "A slot cannot end before it starts: %(slot)s ends on %(end)s."
msgstr ""
"En tidslucka kan inte sluta innan den börjar: %(slot)s slutar den %(end)s."

#. module: vmk_event_slot_multiday
#. odoo-python
#: code:addons/vmk_event_slot_multiday/models/event_slot.py:0
msgid "A slot hour must be between 0:00 and 23:59."
msgstr "En tidsluckas tider måste ligga mellan 0:00 och 23:59."

#. module: vmk_event_slot_multiday
#. odoo-python
#: code:addons/vmk_event_slot_multiday/models/event_slot.py:0
msgid ""
"A slot's end date and its number of days disagree: it ends on %(end)s, which"
" is %(offset)s days after its date, not %(given)s."
msgstr ""
"En tidsluckas slutdatum och dess antal dagar stämmer inte överens: den "
"slutar den %(end)s, vilket är %(offset)s dagar efter dess datum, inte "
"%(given)s."

