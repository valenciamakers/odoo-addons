#. module: base
#: model:ir.module.module,shortdesc:base.module_vmk_event_slot_multiday
msgid "Multi-Day Event Slots"
msgstr "Franges horàries d'esdeveniment de diversos dies"

#. module: base
#: model:ir.module.module,summary:base.module_vmk_event_slot_multiday
msgid "Allow event slots to span multiple days"
msgstr "Permetre que les franges horàries d'esdeveniment abastin diversos dies"

#. module: vmk_event_slot_multiday
#. odoo-python
#: code:addons/vmk_event_slot_multiday/models/event_slot.py:0
msgid "A slot cannot end before it starts: %(slot)s ends on %(end)s."
msgstr ""
"Una franja horària no pot acabar abans de començar: %(slot)s acaba el %(end)s."

#. module: vmk_event_slot_multiday
#. odoo-python
#: code:addons/vmk_event_slot_multiday/models/event_slot.py:0
msgid "A slot hour must be between 0:00 and 23:59."
msgstr "L'hora d'una franja horària ha d'estar entre les 0:00 i les 23:59."

#. module: vmk_event_slot_multiday
#. odoo-python
#: code:addons/vmk_event_slot_multiday/models/event_slot.py:0
msgid ""
"A slot's end date and its number of days disagree: it ends on %(end)s, which"
" is %(offset)s days after its date, not %(given)s."
msgstr ""
"La data de finalització d'una franja horària i el seu nombre de dies no coincideixen: acaba el %(end)s, %(offset)s dies després de la seva data, no %(given)s."

#. module: vmk_event_slot_multiday
#: model_terms:ir.ui.view,arch_db:vmk_event_slot_multiday.view_event_slot_form_multiday
msgid "Date"
msgstr "Data"

#. module: vmk_event_slot_multiday
#: model:ir.model.fields,field_description:vmk_event_slot_multiday.field_event_slot__vmk_end_day_offset
msgid "Days Spanned"
msgstr "Dies que abasta"

#. module: vmk_event_slot_multiday
#: model:ir.model.fields,field_description:vmk_event_slot_multiday.field_event_slot__display_name
msgid "Display Name"
msgstr "Nom mostrat"

#. module: vmk_event_slot_multiday
#: model:ir.model.fields,field_description:vmk_event_slot_multiday.field_event_slot__vmk_end_date
msgid "End Date"
msgstr "Data de finalització"

#. module: vmk_event_slot_multiday
#: model:ir.model,name:vmk_event_slot_multiday.model_event_slot
msgid "Event Slot"
msgstr ""

#. module: vmk_event_slot_multiday
#: model_terms:ir.ui.view,arch_db:vmk_event_slot_multiday.view_event_slot_form_multiday
msgid "Expressed in the event timezone."
msgstr "Expressat en la zona horària de l'esdeveniment."

#. module: vmk_event_slot_multiday
#: model:ir.model.fields,help:vmk_event_slot_multiday.field_event_slot__vmk_end_day_offset
msgid ""
"How many days after its date the slot ends. 0 for a slot within one day."
msgstr ""
"Quants dies després de la seva data acaba la franja horària. 0 en una franja d'un sol dia."

#. module: vmk_event_slot_multiday
#: model:ir.model.fields,field_description:vmk_event_slot_multiday.field_event_slot__id
msgid "ID"
msgstr "ID"

#. module: vmk_event_slot_multiday
#. odoo-javascript
#: code:addons/vmk_event_slot_multiday/static/src/fields/event_slot_daterange_field.js:0
msgid "Slot Date Range"
msgstr "Interval de dates de la franja horària"

#. module: vmk_event_slot_multiday
#: model:ir.model.fields,help:vmk_event_slot_multiday.field_event_slot__vmk_end_date
msgid "The day the slot ends. The same as its date for a slot within one day."
msgstr ""
"El dia en què acaba la franja horària. El mateix que la seva data en una franja d'un sol dia."
