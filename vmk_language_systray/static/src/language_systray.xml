<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="vmk_language_systray.LanguageSystray">
    <div class="o_vmk_language_systray d-none d-md-block">
        <DropdownGroup group="'web-navbar-group'">
            <Dropdown position="'bottom-end'" menuClass="'o_vmk_language_systray_menu'">
                <button class="py-1 py-lg-0" t-att-aria-label="this.buttonLabel" t-att-title="this.buttonLabel">
                    <!-- A Material Symbols glyph, as core's own systray icons are: Odoo 20 no
                         longer loads Font Awesome in the backend, so an `fa` class renders
                         nothing. The glyph must be in core's font subset
                         (`web/static/src/libs/materialsymbols`), which has `public` (a globe)
                         and `translate` but not `language`. No size class, as with the activity
                         and messaging icons beside it (`oi` alone, 1em). -->
                    <i class="oi" data-icon="public" aria-hidden="true"/>
                    <!-- Opt-in, and then only where there is room for it: the flag says the
                         user wants the name, `d-lg-block` still withholds it at widths where
                         it would crowd the row. Hidden either way, the button is a bare globe,
                         which is what makes `buttonLabel` the only accessible name it has. -->
                    <span
                        t-if="this.showName and this.activeLanguage"
                        class="oe_topbar_name d-none d-lg-block ms-2 text-truncate"
                        t-out="this.activeLanguage.name"
                    />
                </button>
                <t t-set-slot="content">
                    <t t-foreach="this.languages" t-as="lang" t-key="lang.code">
                        <!-- `selected` alone marks the active language for sighted users only:
                             core's global `.dropdown-item.selected` rule bolds it and draws a
                             checkmark via a `:before` glyph, which carries no accessible name.
                             `attrs` is DropdownItem's own escape hatch (it spreads through
                             `t-att` in web.DropdownItem), so the state also reaches the
                             accessibility tree, the way core does it for web.CheckboxItem. -->
                        <DropdownItem
                            class="{ selected: this.isActive(lang) }"
                            attrs="{ role: 'menuitemradio', 'aria-checked': this.isActive(lang) ? 'true' : 'false' }"
                            onSelected="() => this.selectLanguage(lang.code)"
                        >
                            <t t-out="lang.name"/>
                        </DropdownItem>
                    </t>
                </t>
            </Dropdown>
        </DropdownGroup>
    </div>
</t>

</templates>
