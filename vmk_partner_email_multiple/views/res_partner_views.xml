<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_partner_form_vmk_email_multiple" model="ir.ui.view">
        <field name="name">res.partner.form.vmk.email.multiple</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <page name="sales_purchases" position="before">
                <page name="vmk_additional_emails" string="Additional Emails">
                    <field name="vmk_email_ids">
                        <list editable="bottom">
                            <!--
                                Declaring any control replaces the default set
                                entirely: list_renderer.js only falls back to
                                its hardcoded "Add a line" when archInfo.controls
                                is empty.
                            -->
                            <control>
                                <create string="Add an email address" />
                            </control>
                            <field name="sequence" widget="handle" />
                            <field name="email" widget="vmk_email_link" />
                            <field name="label" placeholder="e.g. billing" />
                            <button
                                name="action_promote_to_primary"
                                type="object"
                                icon="fa-exchange"
                                title="Swap with the contact's primary email address"
                                invisible="not id"
                            />
                        </list>
                    </field>
                    <p class="text-muted">
                        Mail arriving from any of these addresses is matched to this contact.
                        Nothing is ever sent to them.
                    </p>
                </page>
            </page>
        </field>
    </record>
</odoo>
