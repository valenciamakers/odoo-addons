#. module: vmk_mass_mailing_double_optin
#: model:mail.template,body_html:vmk_mass_mailing_double_optin.mail_template_confirmation
msgid ""
"<div>\n"
"                <p>Please confirm that you'd like to receive <t t-out=\"object.list_id.name or ''\">Newsletter</t> from <t t-out=\"env.company.name or ''\">YourCompany</t>.</p>\n"
"                <div style=\"margin: 32px 0px 32px 0px;\">\n"
"                    <a t-att-href=\"ctx.get('vmk_confirmation_urls', {}).get(object.id, '')\" t-attf-style=\"background-color: {{ env.company.email_secondary_color or '#875A7B' }}; padding: 8px 16px 8px 16px; text-decoration: none; color: {{ env.company.email_primary_color or '#FFFFFF' }}; border-radius: 5px; font-size: 13px;\">\n"
"                        Confirm Subscription\n"
"                    </a>\n"
"                </div>\n"
"                <p>This link is valid for 7 days. If you did not sign up, you can ignore this email and you won't hear from us again.</p>\n"
"            </div>"
msgstr ""
"<div>\n"
"                <p>Confirmeu que voleu rebre <t t-out=\"object.list_id.name or ''\">Newsletter</t> de <t t-out=\"env.company.name or ''\">YourCompany</t>.</p>\n"
"                <div style=\"margin: 32px 0px 32px 0px;\">\n"
"                    <a t-att-href=\"ctx.get('vmk_confirmation_urls', {}).get(object.id, '')\" t-attf-style=\"background-color: {{ env.company.email_secondary_color or '#875A7B' }}; padding: 8px 16px 8px 16px; text-decoration: none; color: {{ env.company.email_primary_color or '#FFFFFF' }}; border-radius: 5px; font-size: 13px;\">\n"
"                        Confirmar la subscripció\n"
"                    </a>\n"
"                </div>\n"
"                <p>Aquest enllaç és vàlid durant 7 dies. Si no us hi heu subscrit, podeu ignorar aquest correu electrònic i no tornareu a saber res de nosaltres.</p>\n"
"            </div>"

