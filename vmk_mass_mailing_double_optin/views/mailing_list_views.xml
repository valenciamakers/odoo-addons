<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mailing_list_view_form" model="ir.ui.view">
        <field name="name">mailing.list.view.form.inherit.vmk_double_optin</field>
        <field name="model">mailing.list</field>
        <field name="inherit_id" ref="mass_mailing.mailing_list_view_form"/>
        <field name="arch" type="xml">
            <field name="is_public" position="after">
                <field name="vmk_double_optin" widget="boolean_toggle"/>
            </field>
        </field>
    </record>

    <record id="mailing_list_view_tree" model="ir.ui.view">
        <field name="name">mailing.list.view.list.inherit.vmk_double_optin</field>
        <field name="model">mailing.list</field>
        <field name="inherit_id" ref="mass_mailing.mailing_list_view_tree"/>
        <field name="arch" type="xml">
            <field name="is_public" position="after">
                <field name="vmk_double_optin" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
