<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vmk_mailing_request_confirmation_view_form" model="ir.ui.view">
        <field name="name">vmk.mailing.request.confirmation.view.form</field>
        <field name="model">vmk.mailing.request.confirmation</field>
        <field name="arch" type="xml">
            <form string="Request Confirmation">
                <group>
                    <field name="list_ids" widget="many2many_tags"
                        options="{'no_create_edit': True, 'no_open': True, 'color_field': 'color'}"
                        placeholder="Select mailing lists..."/>
                    <field name="lang"/>
                    <field name="contact_ids" invisible="1"/>
                    <field name="subscription_count" invisible="1"/>
                </group>
                <div class="alert alert-info mb-0" role="status">
                    <field name="summary" class="o_vmk_request_summary text-break" style="white-space: pre-line;"/>
                </div>
                <footer>
                    <button string="Send Requests" name="action_request_confirmation" type="object"
                        class="btn-primary" data-hotkey="q" invisible="not subscription_count"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="vmk_mailing_request_confirmation_action" model="ir.actions.act_window">
        <field name="name">Request Double Opt-In Email Confirmation</field>
        <field name="res_model">vmk.mailing.request.confirmation</field>
        <field name="view_mode">form</field>
        <field name="context">{"dialog_size": "medium"}</field>
        <field name="target">new</field>
    </record>
</odoo>
