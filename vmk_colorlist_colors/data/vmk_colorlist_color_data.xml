<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

<!-- One record per slot of Odoo's color list, 0 being "No color", each with
     Odoo's name and no custom color. The names are translated by our
     catalogues, in core's own wording. noupdate, so an update keeps a name
     someone changed. -->
<record id="color_0" model="vmk.colorlist.color"><field name="slot">0</field><field name="name">No color</field></record>
<record id="color_1" model="vmk.colorlist.color"><field name="slot">1</field><field name="name">Red</field></record>
<record id="color_2" model="vmk.colorlist.color"><field name="slot">2</field><field name="name">Orange</field></record>
<record id="color_3" model="vmk.colorlist.color"><field name="slot">3</field><field name="name">Yellow</field></record>
<record id="color_4" model="vmk.colorlist.color"><field name="slot">4</field><field name="name">Cyan</field></record>
<record id="color_5" model="vmk.colorlist.color"><field name="slot">5</field><field name="name">Purple</field></record>
<record id="color_6" model="vmk.colorlist.color"><field name="slot">6</field><field name="name">Almond</field></record>
<record id="color_7" model="vmk.colorlist.color"><field name="slot">7</field><field name="name">Teal</field></record>
<record id="color_8" model="vmk.colorlist.color"><field name="slot">8</field><field name="name">Blue</field></record>
<record id="color_9" model="vmk.colorlist.color"><field name="slot">9</field><field name="name">Raspberry</field></record>
<record id="color_10" model="vmk.colorlist.color"><field name="slot">10</field><field name="name">Green</field></record>
<record id="color_11" model="vmk.colorlist.color"><field name="slot">11</field><field name="name">Violet</field></record>

</odoo>
