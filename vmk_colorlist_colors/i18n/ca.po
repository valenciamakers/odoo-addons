#. module: vmk_colorlist_colors
#: model:ir.module.module,summary:base.module_vmk_colorlist_colors
msgid ""
"Change the colors used for tags, kanban cards, and calendars, and their "
"names"
msgstr ""
"Canviar els colors de les etiquetes, les targetes kanban i els calendaris, i"
" els seus noms"

#. module: vmk_colorlist_colors
#. odoo-python
#: code:addons/vmk_colorlist_colors/models/vmk_colorlist_color.py:0
msgid ""
"Choose a color with the color picker. %(value)s is not a color in the form "
"#rrggbb."
msgstr ""
"Trieu un color amb el selector de colors. %(value)s no és un color de la "
"forma #rrggbb."

