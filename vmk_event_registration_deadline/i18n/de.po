#. module: base
#: model:ir.module.module,summary:base.module_vmk_event_registration_deadline
msgid ""
"Allow registration only until an event starts, or a set time in advance"
msgstr ""
"Registrierung nur bis zum Beginn einer Veranstaltung oder eine bestimmte "
"Zeit davor zulassen"

#. module: vmk_event_registration_deadline
#: model:ir.model.fields,help:vmk_event_registration_deadline.field_res_config_settings__vmk_registration_deadline_enabled
