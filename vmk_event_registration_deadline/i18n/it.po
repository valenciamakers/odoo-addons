#. module: base
#: model:ir.module.module,shortdesc:base.module_vmk_event_registration_deadline
msgid "Event Registration Deadline"
msgstr "Scadenza registrazione evento"

#. module: base
#: model:ir.module.module,summary:base.module_vmk_event_registration_deadline
msgid ""
"Allow registration only until an event starts, or a set time in advance"
msgstr ""
"Consente la registrazione solo fino all'inizio di un evento, o fino a un "
"certo tempo prima"

#. module: vmk_event_registration_deadline
#: model:ir.model.fields,help:vmk_event_registration_deadline.field_res_config_settings__vmk_registration_deadline_enabled
#: model_terms:ir.ui.view,arch_db:vmk_event_registration_deadline.res_config_settings_view_form
msgid ""
"Allow registration only until an event starts, or a set time in advance. Set"
" to 00:00 to end registration at the event start time."
msgstr ""
"Consente la registrazione solo fino all'inizio di un evento, o fino a un "
"certo tempo prima. Imposta 00:00 per chiudere le registrazioni all'orario di"
" inizio dell'evento."

#. module: vmk_event_registration_deadline
#: model_terms:ir.ui.view,arch_db:vmk_event_registration_deadline.view_event_form_deadline
msgid "Before Start"
msgstr "prima dell'inizio"

