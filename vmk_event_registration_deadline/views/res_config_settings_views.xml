<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.registration.deadline</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="event.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Core's own Registration block, which is where a rule about
                 when registration closes belongs. -->
            <xpath expr="//block[@name='registration_setting_container']" position="inside">
                <!-- `help` on the setting as well as on the field, the way
                     core writes `use_event_barcode` in this same page and
                     `use_invoice_terms` in account. The setting renders the
                     boolean as its checkbox and the help beneath the label. -->
                <setting id="vmk_registration_deadline"
                         help="Allow registration only until an event starts, or a set time in advance. Set to 00:00 to end registration at the event start time.">
                    <field name="vmk_registration_deadline_enabled"/>
                    <!-- float_time rather than loose text naming the unit:
                         the value then reads as a duration on its own, and a
                         `setting` strips a `label` anyway. It also keeps the
                         catalogue free of a msgid that would be markup. -->
                    <div class="content-group mt16"
                         invisible="not vmk_registration_deadline_enabled">
                        <!-- Label before the field, carrying core's own
                             classes, as `use_google_maps_static_api` does in
                             this same page. A label placed after the field,
                             or without them, is dropped. -->
                        <label for="vmk_registration_deadline_hours"
                               class="o_form_label col-lg-4 o_light_label"/>
                        <field name="vmk_registration_deadline_hours"
                               widget="float_time" class="o_light_label"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
