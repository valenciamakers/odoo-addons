<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        Both records anchor on the view's root tag, which this repo's conventions
        otherwise warn against, since core renamed `<tree>` to `<list>` in 18
        while keeping the old view record ids. There is no way around it here:
        `default_order` is an attribute of the root element, and setting it means
        naming that element. The tests read the processed arch back and assert
        the attribute arrived, so a future rename fails loudly instead of
        silently leaving the Apps page in its original order.
    -->
    <record id="module_view_kanban_sorted" model="ir.ui.view">
        <field name="name">ir.module.module.kanban.apps.page.sort</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.module_view_kanban" />
        <field name="arch" type="xml">
            <kanban position="attributes">
                <attribute name="default_order">application desc, shortdesc</attribute>
            </kanban>
        </field>
    </record>

    <record id="module_tree_sorted" model="ir.ui.view">
        <field name="name">ir.module.module.list.apps.page.sort</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.module_tree" />
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="default_order">application desc, shortdesc</attribute>
            </list>
        </field>
    </record>
</odoo>
