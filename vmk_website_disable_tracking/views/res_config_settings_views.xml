<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- Beside the cookies bar, under Tracking & SEO, for the website chosen at
     the top of the page. -->
<record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.vmk_website_disable_tracking</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="website.res_config_settings_view_form"/>
    <field name="arch" type="xml">
        <xpath expr="//setting[@id='website_cookies_bar_setting']" position="before">
            <setting id="vmk_track_visitors_setting"
                     help="Record each visitor and the pages they view, under Website › Reporting › Visitors. Off, the website records no visitors at all.">
                <field name="website_vmk_track_visitors"/>
            </setting>
        </xpath>
    </field>
</record>

</odoo>
