<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_event_form_host" model="ir.ui.view">
        <field name="name">event.event.form.host</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <!-- Anchored on fields and named pages rather than the root tag,
                 which survives core renaming its own elements. -->
            <field name="user_id" position="after">
                <field name="vmk_host_names" string="Hosts" widget="vmk_host_summary"
                       options="{'page': 'vmk_hosts'}"
                       placeholder="Added in the Hosts tab"/>
            </field>
            <page name="tickets" position="after">
                <page string="Hosts" name="vmk_hosts">
                    <field name="vmk_host_ids">
                        <list string="Hosts" editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="partner_id"/>
                            <field name="role" placeholder="Lead, Assistant, Guest speaker…"/>
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>

    <record id="view_event_tree_host" model="ir.ui.view">
        <field name="name">event.event.list.host</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_tree"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="vmk_host_partner_ids" widget="many2many_tags" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_event_search_host" model="ir.ui.view">
        <field name="name">event.event.search.host</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_search"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="vmk_host_partner_ids" string="Host"/>
            </field>
            <filter name="venue" position="after">
                <filter string="Host" name="vmk_host_partner_ids"
                        context="{'group_by': 'vmk_host_partner_ids'}"/>
            </filter>
        </field>
    </record>

</odoo>
